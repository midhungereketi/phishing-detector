# Copy to .env in this directory. Optional secrets stay in the Python backend.
VIRUSTOTAL_API_KEY=
PHISHTANK_APP_KEY=
# Optional comma-separated extension origins, e.g. chrome-extension://your-extension-id
PHISHGUARD_EXTENSION_ORIGINS=
# New-account email verification. Use a Resend API key and a sender on a domain
# you own and have verified with Resend. Never put the key in VITE_ variables.
RESEND_API_KEY=
PHISHGUARD_EMAIL_FROM=
# Alternative when you do not own a sending domain: use an SMTP account.
# For Gmail, use smtp.gmail.com:587 and a Google App Password (never your login password).
PHISHGUARD_SMTP_HOST=
PHISHGUARD_SMTP_PORT=587
PHISHGUARD_SMTP_USERNAME=
PHISHGUARD_SMTP_PASSWORD=
# Cloud only: pooled Postgres connection URL. Leave unset for local SQLite.
# DATABASE_URL=
# PHISHGUARD_ALLOWED_HOSTS=phishing-detector-pink.vercel.app
# PHISHGUARD_PUBLIC_ORIGIN=https://phishing-detector-pink.vercel.app
# PHISHGUARD_SECURE_COOKIE=1
# PHISHGUARD_AUTO_MIGRATE=1
